---
/*
 * Landing page hero: three mini-UI cards (deploy terminal, visibility
 * popover, DNS records). On load each card plays its story front and
 * center, recedes into a deck, and the sequence settles as one central
 * cluster: big terminal in front, the other two tucked behind (mobile
 * keeps only the full-width terminal). A subtle replay control appears
 * once settled. The frontmatter title still sets <title>; Starlight's
 * rendered h1 panel is hidden.
 */
---

    <section class="ph-hero not-content">
      <div class="ph-cards">
        <div class="ph-card ph-card-1" aria-hidden="true">
          <div class="ph-visual ph-terminal">
            <div class="ph-chrome">
              <i />
              <i />
              <i />
            </div>
            <div class="ph-term-body">
              <p class="ph-cmd">$ <span class="ph-typed">buzz deploy ./dist --site rocket</span></p>
              <p class="ph-out ph-out-1">
                <span class="ph-term-ok">✓</span> Uploaded
              </p>
              <p class="ph-out ph-out-2">Deployed to rocket.launchpad.example (public)</p>
            </div>
          </div>
          <div class="ph-site-pop">
            <div class="ph-site-win">
              <p class="ph-site-url">rocket.launchpad.example</p>
              <div class="ph-site-skel">
                <i />
                <i />
                <i />
              </div>
            </div>
          </div>
        </div>
        <div class="ph-card ph-card-2" aria-hidden="true">
          <div class="ph-visual ph-popover">
            <p class="ph-box-head">Who can view this site</p>
            <div class="ph-rows">
              <div class="ph-row ph-row-public">
                <p class="ph-row-top">
                  <svg class="ph-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
                    <circle cx="8" cy="8" r="6.2" />
                    <ellipse cx="8" cy="8" rx="2.8" ry="6.2" />
                    <path d="M2 8h12" />
                  </svg>
                  Public
                  <svg class="ph-tick ph-tick-public" viewBox="0 0 12 12">
                    <path d="M2 6.5 4.8 9.2 10 3.5" />
                  </svg>
                </p>
                <p class="ph-row-desc">Anyone can view this site.</p>
              </div>
              <div class="ph-row ph-row-private">
                <p class="ph-row-top">
                  <svg class="ph-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75">
                    <rect x="3" y="7" width="10" height="6.5" />
                    <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
                  </svg>
                  Private
                  <svg class="ph-tick ph-tick-private" viewBox="0 0 12 12">
                    <path d="M2 6.5 4.8 9.2 10 3.5" />
                  </svg>
                </p>
                <p class="ph-row-desc">Only you can view this site.</p>
              </div>
            </div>
          </div>
          <svg class="ph-cursor" viewBox="0 0 20 20">
            <path d="M3.5 2.5 L3.5 17 L8 12.9 L10.7 18 L13.4 16.7 L10.9 11.7 L16.8 11.3 Z" />
          </svg>
        </div>
        <div class="ph-card ph-card-3" aria-hidden="true">
          <div class="ph-visual ph-domain">
            <p class="ph-box-head ph-domain-head">
              <i class="ph-dot" />
              www.rocket.example
            </p>
            <div class="ph-rec">
              <span class="ph-rec-type">A</span>
              <span class="ph-rec-val">www → 203.0.113.10</span>
              <svg class="ph-tick ph-rec-check-1" viewBox="0 0 12 12">
                <path d="M2 6.5 4.8 9.2 10 3.5" />
              </svg>
            </div>
            <div class="ph-rec">
              <span class="ph-rec-type">TXT</span>
              <span class="ph-rec-val">_buzz.www → buzz-domain-verification=8f3c1a</span>
              <svg class="ph-tick ph-rec-check-2" viewBox="0 0 12 12">
                <path d="M2 6.5 4.8 9.2 10 3.5" />
              </svg>
            </div>
            <div class="ph-domain-foot">
              <p class="ph-note">rocket.launchpad.example still works</p>
              <p class="ph-chip">
                <span class="ph-chip-a">Connecting</span>
                <span class="ph-chip-b">Connected</span>
              </p>
            </div>
          </div>
        </div>
        <button class="ph-replay" type="button" aria-label="Replay the deploy animation">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M13.5 8a5.5 5.5 0 1 1-1.61-3.89" />
            <path d="M13.9 1.6v3.1h-3.1" />
          </svg>
        </button>
      </div>
      <div class="ph-copy">
        <h1 class="ph-title">Publish static sites on your server</h1>
        <p class="ph-tagline">
          A self-hosted alternative to Surge.sh. Deploy a directory from the
          CLI to its own subdomain.
        </p>
        <p class="ph-actions">
          <a class="ph-primary" href="./getting-started/deploy-your-first-site/">
            Deploy your first site →
          </a>
          <a class="ph-minimal" href="./self-hosting/overview/">
            Self-host Buzz
          </a>
        </p>
      </div>
    </section>

<script>
  // replay control: rewind every CSS animation in the deck and play again
  const cards = document.querySelector('.ph-cards');
  const replay = document.querySelector('.ph-replay');
  if (cards && replay) {
    replay.addEventListener('click', () => {
      for (const animation of cards.getAnimations({ subtree: true })) {
        if (animation instanceof CSSAnimation) {
          animation.currentTime = 0;
          animation.play();
        }
      }
    });
  }
</script>

<style>
  /* the frontmatter title still sets <title>; hide Starlight's rendered h1 panel */
  :global(.content-panel:has(h1#_top)) {
    display: none;
  }

  .ph-hero {
    --proto-ink: #0b0c0c;
    --proto-paper: #ffffff;
    --proto-mist: #f3f2f1;
    --proto-hairline: #b1b4b6;
    --proto-muted: #505a5f;
    --proto-success: #0f7a52;
    --proto-term-bg: #23262f;
    --proto-term-fg: #d6deeb;
    --proto-term-ok: #6fd39b;
    --proto-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --proto-ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --proto-ease-swap: cubic-bezier(0.2, 0, 0, 1);
    --proto-cursor-y: -7.1rem;
    display: flex;
    flex-direction: column;
    /* the top pad holds the deck clear of the sticky header: the receding
       peeks and card 2's incoming cursor both rise above the cards box */
    padding-block: 2.9rem 2.5rem;
    border-block-end: 4px solid var(--proto-ink);
  }

  .ph-hero :where(h1, p) {
    margin: 0;
  }

  /* the cards box stops at the settled spread, so this gap also has to
     absorb the front card and the site window hanging past it */
  .ph-copy {
    margin-block-start: 2.6rem;
    text-align: center;
  }

  .ph-hero .ph-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .ph-hero .ph-tagline {
    margin-block-start: 0.75rem;
    font-size: 1rem;
    color: var(--proto-muted);
    max-width: 46ch;
    margin-inline: auto;
  }

  .ph-hero .ph-actions {
    margin-block-start: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .ph-primary {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: 2px solid var(--proto-ink);
    background: var(--proto-ink);
    color: var(--proto-paper);
    font-weight: 700;
    text-decoration: none;
  }

  .ph-primary:hover {
    background: var(--proto-paper);
    color: var(--proto-ink);
  }

  .ph-minimal {
    font-weight: 700;
    color: var(--proto-ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  /*
   * Autoplay timeline (ms from load). Each card plays its story front and
   * center, then recedes up into the deck (smaller, slightly faded) as the
   * next card lands on top:
   * A card's story completes, briefly holds, then it recedes; the next
   * card rises into the slot midway through the recede. The sequence
   * ends with the deck spreading into all three cards, which stay.
   *    0 card 1 enters front, 330-1716 the command types itself,
   *      2112/2310 output prints after a beat, 2508-3194 the site window
   *      rises out past the terminal's bottom edge
   * 3458 card 1 recedes; 3722 card 2 rises into the slot,
   *      4184 the cursor flies in, ~5056 it clicks, 5108/5135 the check
   *      moves to Private
   * 5821 card 2 recedes; 6085 card 3 rises into the slot,
   *      6785/7022 records verify, 7247 the badge connects (done 8435)
   * 8831-9359 the finale: the deck spreads and stays: terminal front
   *      and center, privacy left behind, domain right behind
   *      (on small screens only the terminal remains, full width)
   * Base styles are the FINAL state; keyframes replay the before -> after
   * with both-fill. The sequence plays once and settles in the spread;
   * under reduced motion it rests there from the start.
   */
  /* 30% larger on desktop. transform, not zoom: zoom is layout-based and
     makes moving composited layers snap to device pixels independently
     (visible jitter when cards cross); scale keeps one GPU transform
     space. The margin compensates for the unscaled layout box. */
  @media (min-width: 56rem) {
    .ph-cards {
      transform: scale(1.3);
      transform-origin: 50% 0;
      margin-block-end: calc(13.6rem * 0.3);
    }
  }

  .ph-cards {
    --pose-front: translate(-50%, 0);
    --pose-mid: translate(-50%, -1.2rem) scale(0.95);
    --pose-back: translate(-50%, -2.4rem) scale(0.9);
    /* the settled cluster: the terminal in front at 0.8, the two cards it
       introduced centered on its horizontal midline, half-tucked behind */
    --pose-spread-1: translate(-50%, 0.9rem) scale(0.8);
    --pose-spread-2: translate(calc(-50% - 12rem), 2.13rem) scale(0.6);
    --pose-spread-3: translate(calc(-50% + 12rem), 2.13rem) scale(0.6);
    position: relative;
    inline-size: min(30rem, 100%);
    margin-inline: auto;
    /* down to the settled terminal and the window under it, so nothing is
       left over; the behind cards ride above this edge, and the full-size
       front card reaches past it into the copy gap */
    block-size: 13.6rem;
  }

  /* on small screens the copy leads, the cards follow, and the final spread
     tightens so three-up still fits the narrow container. This has to come
     after the .ph-cards rule above: same specificity, so source order wins. */
  @media (max-width: 55.99rem) {
    .ph-hero {
      /* with the cards last, the end pad carries the front card and the site
         window, which reach far below the settled spread */
      padding-block: 2.5rem 4.75rem;
    }

    .ph-copy {
      order: -1;
      margin-block-start: 0;
    }

    .ph-cards {
      /* clears the cursor flying in above the deck, then the peeks */
      margin-block-start: 3.9rem;
      block-size: 12.25rem;
      /* the finale keeps only the terminal, full width; the side cards
         tuck behind it and fade out */
      --pose-spread-fade: 0;
      --pose-spread-1: translate(-50%, 0) scale(1);
      --pose-spread-2: translate(-50%, 1rem) scale(0.5);
      --pose-spread-3: translate(-50%, 1rem) scale(0.5);
    }

    .ph-card-2,
    .ph-card-3 {
      opacity: 0;
    }
  }

  /* subtle: borderless and muted, fading in only once the story settles;
     replaying rewinds this fade-in too, so it hides itself during runs */
  .ph-replay {
    position: absolute;
    right: -6rem;
    bottom: 0;
    z-index: 5;
    display: inline-grid;
    place-items: center;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--proto-muted);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    animation: ph-appear 360ms var(--proto-ease-out) 9600ms forwards;
  }

  @keyframes ph-appear {
    to {
      opacity: 1;
      visibility: visible;
    }
  }

  .ph-replay svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .ph-replay:hover {
    color: var(--proto-ink);
  }

  @media (max-width: 55.99rem) {
    .ph-replay {
      right: 0;
      bottom: -2.9rem;
    }
  }

  /* nothing animates under reduced motion, so there is nothing to replay */
  @media (prefers-reduced-motion: reduce) {
    .ph-replay {
      display: none;
    }
  }

  /* promote the animating layers to the compositor: blur/transform/opacity
     otherwise re-rasterize on the main thread each frame */
  .ph-card,
  .ph-card::after,
  .ph-site-pop,
  .ph-cursor {
    will-change: transform, opacity, filter;
  }

  .ph-card {
    position: absolute;
    top: 0;
    left: 50%;
    inline-size: 100%;
    transform-origin: 50% 0;
  }

  /* receded cards dim under a paper scrim instead of going translucent,
     so the card behind never bleeds through the one in front */
  .ph-card-1::after,
  .ph-card-2::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
    background: var(--proto-paper);
    pointer-events: none;
  }

  .ph-card-1 {
    z-index: 3;
    transform: var(--pose-spread-1);
    animation: ph-deck-1 9372ms var(--proto-ease-in-out) both;
  }

  .ph-card-1::after {
    opacity: 0;
    animation: ph-dim-1 9372ms var(--proto-ease-in-out) both;
  }

  .ph-card-2 {
    z-index: 2;
    transform: var(--pose-spread-2);
    animation: ph-deck-2 5636ms var(--proto-ease-in-out) 3722ms both;
  }

  .ph-card-2::after {
    opacity: 0;
    animation: ph-dim-2 5636ms var(--proto-ease-in-out) 3722ms both;
  }

  .ph-card-3 {
    z-index: 2;
    transform: var(--pose-spread-3);
    animation: ph-deck-3 3274ms var(--proto-ease-in-out) 6085ms both;
  }

  @keyframes ph-deck-1 {
    0% {
      opacity: 0;
      transform: translate(-50%, 18px);
      filter: blur(0);
      z-index: 1;
    }
    5.1% {
      opacity: 1;
      transform: var(--pose-front);
    }
    36.9% {
      transform: var(--pose-front);
      filter: blur(0);
    }
    42.5%,
    64.9% {
      transform: var(--pose-mid);
      filter: blur(0.8px);
    }
    70.3%,
    94.2% {
      transform: var(--pose-back);
      filter: blur(1.5px);
      z-index: 1;
    }
    100% {
      transform: var(--pose-spread-1);
      filter: blur(0);
      z-index: 3;
    }
  }

  @keyframes ph-dim-1 {
    0%,
    36.9% {
      opacity: 0;
    }
    42.5%,
    64.9% {
      opacity: 0.25;
    }
    70.3%,
    94.2% {
      opacity: 0.45;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ph-deck-2 {
    0% {
      opacity: 0;
      transform: translate(-50%, 18px);
      filter: blur(0);
    }
    7% {
      opacity: 1;
      transform: var(--pose-front);
    }
    37.2% {
      transform: var(--pose-front);
      filter: blur(0);
    }
    46.6%,
    90.6% {
      opacity: 1;
      transform: var(--pose-mid);
      filter: blur(0.8px);
    }
    100% {
      opacity: var(--pose-spread-fade, 1);
      transform: var(--pose-spread-2);
      filter: blur(0);
    }
  }

  @keyframes ph-dim-2 {
    0%,
    37.2% {
      opacity: 0;
    }
    46.6%,
    90.6% {
      opacity: 0.25;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes ph-deck-3 {
    0% {
      opacity: 0;
      transform: translate(-50%, 18px);
      filter: blur(0);
      z-index: 3;
    }
    15.3% {
      opacity: 1;
      transform: var(--pose-front);
    }
    83.9% {
      opacity: 1;
      transform: var(--pose-front);
      filter: blur(0);
      z-index: 3;
    }
    100% {
      opacity: var(--pose-spread-fade, 1);
      transform: var(--pose-spread-3);
      filter: blur(0);
      z-index: 2;
    }
  }

  /* ---- mini-UI cards ---- */
  .ph-visual {
    block-size: 12.25rem;
    border: 2px solid var(--proto-ink);
    background: var(--proto-paper);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ph-box-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    block-size: 2.2rem;
    padding-inline: 0.75rem;
    background: var(--proto-mist);
    border-block-end: 2px solid var(--proto-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .ph-icon {
    inline-size: 1rem;
    block-size: 1rem;
    flex: none;
  }

  .ph-tick {
    inline-size: 0.8rem;
    block-size: 0.8rem;
    flex: none;
    fill: none;
    stroke: var(--proto-success);
    stroke-width: 2.2;
  }

  /* card 1: terminal */
  .ph-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    block-size: 2.2rem;
    padding-inline: 0.75rem;
    background: #16181d;
  }

  .ph-chrome i {
    inline-size: 9px;
    block-size: 9px;
    background: #5a6172;
  }

  .ph-terminal {
    background: var(--proto-term-bg);
  }

  .ph-term-body {
    padding: 0.75rem;
    font: 0.72rem / 1.8 var(--sl-font-mono);
    color: var(--proto-term-fg);
  }

  .ph-term-ok {
    color: var(--proto-term-ok);
  }

  .ph-typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    inline-size: 32ch;
    animation: ph-type 1386ms steps(32) 330ms both;
  }

  @keyframes ph-type {
    from {
      inline-size: 0;
    }
    to {
      inline-size: 32ch;
    }
  }

  .ph-cmd::after {
    content: '';
    display: inline-block;
    inline-size: 0.5em;
    block-size: 1em;
    vertical-align: text-bottom;
    margin-inline-start: 0.15em;
    background: var(--proto-term-fg);
    opacity: 0;
    animation: ph-blink 1.1s step-end infinite;
  }

  .ph-out-1 {
    animation: ph-rise 317ms var(--proto-ease-out) 2112ms both;
  }

  .ph-out-2 {
    animation: ph-rise 317ms var(--proto-ease-out) 2310ms both;
  }

  /* the deployed site hangs past the terminal's bottom edge; it sits outside
     the clipped .ph-visual, so the entrance is masked by its own clip-path.
     `right` keeps it clear of card 2's leading edge. */
  .ph-site-pop {
    position: absolute;
    right: 3rem;
    bottom: -0.7rem;
    inline-size: 58%;
    transform: rotate(-2.5deg);
    animation: ph-pop 686ms var(--proto-ease-out) 2508ms both;
  }

  .ph-site-win {
    border: 2px solid var(--proto-ink);
    background: var(--proto-paper);
  }

  .ph-site-url {
    padding: 0.35rem 0.6rem;
    background: var(--proto-mist);
    border-block-end: 1px solid var(--proto-hairline);
    font: 700 0.64rem var(--sl-font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ph-site-skel {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.6rem;
  }

  .ph-site-skel i {
    block-size: 5px;
    background: var(--proto-hairline);
  }

  .ph-site-skel i:nth-child(1) {
    inline-size: 45%;
    background: var(--proto-ink);
  }

  .ph-site-skel i:nth-child(2) {
    inline-size: 88%;
  }

  .ph-site-skel i:nth-child(3) {
    inline-size: 64%;
  }

  @keyframes ph-blink {
    50% {
      opacity: 1;
    }
  }

  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ph-pop {
    from {
      clip-path: inset(100% 0 0 0);
      transform: translateY(30%) rotate(-5deg);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: translateY(0) rotate(-2.5deg);
    }
  }

  /* card 2: visibility popover */
  .ph-rows {
    flex: 1;
    display: grid;
    grid-template-rows: 1fr 1fr;
  }

  .ph-row {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: 0.75rem;
  }

  .ph-row + .ph-row {
    border-block-start: 2px solid var(--proto-ink);
  }

  .ph-row-top {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .ph-row-top .ph-tick {
    margin-inline-start: auto;
    stroke: var(--proto-ink);
  }

  .ph-tick-public {
    opacity: 0;
    animation: ph-fade-away 264ms var(--proto-ease-swap) 5108ms both;
  }

  .ph-tick-private {
    animation: ph-check-in 422ms var(--proto-ease-out) 5135ms both;
  }

  .ph-row-desc {
    margin: 0.2rem 0 0 1.55rem;
    font-size: 0.72rem;
    color: var(--proto-muted);
  }

  .ph-row-private {
    animation: ph-row-hover 1518ms var(--proto-ease-swap) 4184ms both;
  }

  /* a sibling of the clipped .ph-visual so it can fly in from off the card;
     `top` lands it on the first row's tick, past the head and both borders */
  .ph-cursor {
    position: absolute;
    top: calc(2.2rem + 1.6rem + 4px);
    left: 64%;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    fill: var(--proto-ink);
    stroke: var(--proto-paper);
    stroke-width: 1.5;
    opacity: 0;
    z-index: 2;
    animation: ph-cursor-act 1518ms var(--proto-ease-in-out) 4184ms both;
  }

  @keyframes ph-cursor-act {
    0% {
      opacity: 0;
      transform: translate(2.4rem, var(--proto-cursor-y));
    }
    7% {
      opacity: 1;
    }
    26%,
