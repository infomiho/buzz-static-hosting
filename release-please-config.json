{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    "cli": {
      "release-type": "node",
      "package-name": "@infomiho/buzz-cli"
    },
    "server": {
      "release-type": "python",
      "package-name": "buzz-server",
      "component": "server",
      "extra-files": [
        "src/server/__init__.py",
        { "type": "generic", "path": "docker-compose.yml" }
      ]
    }
  }
}
